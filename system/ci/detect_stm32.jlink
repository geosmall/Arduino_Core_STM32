// J-Link script to auto-detect STM32 device ID
// Works with any STM32 family without prior knowledge

// Use Cortex-M4 for initial connection (works for M0/M3/M4/M7)
device CORTEX-M4
connect

// Read DBGMCU_IDCODE register - different addresses by family
// STM32F0/F1/F3/F4/L0/L1/L4/G0/G4/F7: 0xE0042000
// STM32H7: 0x5C001000
mem32 0xE0042000,1
mem32 0x5C001000,1

// CPUID register for ARM core info
mem32 0xE000ED00,1

// Exit
exit
